# ─────────────────────────────────────────────
# CellGenic Portal — environment
# Copy to .env.local for local dev, and set the same keys in the Vercel
# project settings for production.
# ─────────────────────────────────────────────

# WordPress site. Used for JWT login and every cellgenic/v1 endpoint.
# NEXT_PUBLIC_ because the browser calls those endpoints directly with
# the signed-in user's own token.
NEXT_PUBLIC_WP_URL=https://cellgenic.com

# WooCommerce REST base. Same host in production; separate variable so a
# staging store can be pointed at independently.
NEXT_PUBLIC_WC_URL=https://cellgenic.com

# WooCommerce REST keys — WooCommerce → Settings → Advanced → REST API.
# NOT NEXT_PUBLIC: these must never reach the browser. Only the
# /api/* server routes read them.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret for server-to-server calls into WordPress (DocuSign
# consent write-back). Must match the CELLGENIC_SERVICE_TOKEN constant in
# wp-config.php. Generate with: openssl rand -hex 32
CELLGENIC_SERVICE_TOKEN=

# Roberto's inventory API (read-only stock)
CELLGENIC_OPS_API_URL=https://cellgenic-ops.vercel.app/api/v1/inventory
CELLGENIC_OPS_API_KEY=

# DocuSign. Currently pointed at the demo environment in the route files —
# see src/app/api/docusign/send/route.ts before going live.
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_TEMPLATE_RESEARCH=
DOCUSIGN_TEMPLATE_COSMETIC=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_CONNECT_HMAC_KEY=
